---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout title="Page not found" description="The page you are looking for does not exist." canonical="/404" robots="noindex">
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-24 text-center">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-black/50">404</p>
    <h1 class="mt-4 font-serif text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-base leading-7 text-black/75">The page you are looking for does not exist or has moved.</p>
    <a class="mt-8 inline-block text-base font-semibold underline underline-offset-4" href="/">Back to home</a>
  </main>
</MainLayout>
