---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import PageShell from "../PageShell.astro";
import type { Locale } from "../../i18n";
import { localizedPath, ui } from "../../i18n";
interface Props { locale?: Locale }
const locale = Astro.props.locale ?? "en";
const copy = ui[locale].teaching;
const students = await getCollection(locale === "bg" ? "studentsBg" : "studentsEn");
const sortedStudents = students.map((entry) => entry.data).sort((a, b) => b.year - a.year || a.names.localeCompare(b.names));

const courses = (await getCollection("teaching")).filter((course) => course.id.endsWith(`-${locale}`));
const sortedCourses = courses.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
const renderedCourses = await Promise.all(sortedCourses.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
})));

---
<MainLayout
    title={copy.name}
    description={copy.summary}
    canonical={localizedPath(locale, "/teaching")}
    locale={locale}
    keywords={[...copy.keywords]}
>
    <PageShell>
        <Fragment slot="page-name">{copy.name}</Fragment>
        <Fragment slot="page-title">{copy.title}</Fragment>
        <Fragment slot="page-summary">{copy.summary}</Fragment>

        <section slot="one-column" class="grid gap-6 pt-8">
        {renderedCourses.map(({ entry: course, Content: CourseContent }, index) => (
            <article class="grid gap-6 border border-black/15 bg-white p-5 md:p-6 lg:grid-cols-[120px_1fr]">
                <div>
                <span class="text-s font-bold uppercase tracking-[0.18em]">
                    {String(index + 1).padStart(2, "0")}
                </span>
                </div>

                <div>
                <h2 class="font-serif text-3xl font-bold leading-tight">
                    {course.data.title}
                </h2>

                <p class="mt-3 text-sm text-black/50">
                    {course.data.level}, {course.data.year}, {course.data.semester} {copy.semester}
                </p>

                <div class="course-content mt-4 leading-7 text-black/75">
                    <CourseContent />
                </div>

                {course.data.links?.length > 0 && (
                        <>
                        <div class="pt-5"></div>
                            {course.data.links.map((link, idx) => (
                                <>
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="link"
                                    >
                                        {link.label}
                                    </a>

                                    {idx < course.data.links.length - 1 && (
                                        <span class="text-black/20 text-3xl">·</span>
                                    )}
                                </>
                            ))}
                        </>
                    )}
                </div>
            </article>
            ))}
        </section>

        <section slot="one-column" class="mt-12">
    <div class="border-b-2 border-black pb-6">
        <p class="text-sm uppercase tracking-[0.18em] text-black/60">
            {copy.supervision}
        </p>

        <h2 class="mt-2 font-serif text-4xl font-bold md:text-5xl">
            {copy.graduates}
        </h2>

        <p class="mt-4 leading-7 text-black/75">
            {copy.supervisionText}
        </p>
    </div>

    <div class="grid gap-x-8 gap-y-6 pt-8 md:grid-cols-2">
        {sortedStudents.map((student, index) => (
            <article class="border border-black/15 bg-white p-5 md:p-6">
                <div class="flex items-start justify-between gap-4">
                    <span class="text-sm font-bold uppercase tracking-[0.18em] text-black/50">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <div class="">
                        <span class="pr-5 text-sm">{student.year}</span>
                        <span class="border border-black px-2 py-1 text-[11px] uppercase tracking-[0.14em]">
                            {student.level}
                        </span>
                    </div>
                    
                </div>

                <h3 class="mt-4 font-serif text-2xl font-bold leading-tight">
                    {student.names}
                </h3>

                <p class="mt-3 text-base leading-6 text-black/75">
                    {student.title}
                </p>
              
                {student.links?.length > 0 && (
                    <div class="mt-4 flex flex-wrap items-center gap-x-3 text-sm text-black/50">
                            {student.links.map((link, idx) => (
                                <>
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="link"
                                    >
                                        {link.label}
                                    </a>

                                    {idx < student.links.length - 1 && (
                                        <span class="text-black/20">·</span>
                                    )}
                                </>
                            ))}
                    </div>
                )}
            </article>
        ))}
    </div>
</section>

    </PageShell> 
</MainLayout>
