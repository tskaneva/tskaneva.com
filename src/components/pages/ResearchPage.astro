---
import MainLayout from "../../layouts/MainLayout.astro";
import PageShell from "../PageShell.astro";
import { getCollection, render } from "astro:content";
import researchAreasEn from "../../data/research-areas-en.yaml";
import researchAreasBg from "../../data/research-areas-bg.yaml";
import type { Locale } from "../../i18n";
import { localizedPath, ui } from "../../i18n";

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? "en";
const copy = ui[locale].research;
const researchAreas = locale === "bg" ? researchAreasBg : researchAreasEn;
const projects = (await getCollection("projects")).filter((project) => project.id.endsWith(`-${locale}`));
const laboratory = (await getCollection("laboratories")).find((entry) => entry.id.endsWith(`-${locale}`));
if (!laboratory) throw new Error(`Missing laboratory content for locale: ${locale}`);
const { Content: LaboratoryContent } = await render(laboratory);

const getLatestProjectYear = (period?: string) => {
  const years = period?.match(/\d{4}/g)?.map(Number) ?? [];

  return years.length > 0 ? Math.max(...years) : 0;
};

const sortedProjects = projects.sort(
  (a, b) =>
    getLatestProjectYear(b.data.period) - getLatestProjectYear(a.data.period) ||
    a.data.title.localeCompare(b.data.title)
);
const renderedProjects = await Promise.all(sortedProjects.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
})));

const sortedResearchAreas = researchAreas.sort(
  (a, b) => a.order - b.order || a.title.localeCompare(b.title)
);

---
<MainLayout
    title={copy.name}
    description={copy.projectsSummary}
    canonical={localizedPath(locale, "/research")}
    locale={locale}
    keywords={[...copy.keywords]}
>
    <PageShell>
        <Fragment slot="page-name">{copy.name}</Fragment>
        <Fragment slot="page-title">
            {copy.title}
        </Fragment>
        <Fragment slot="page-summary">{copy.projectsSummary}</Fragment>

        <section slot="one-column">

            <!-- Overview -->
            <article class="border-b-2 border-black py-8 lg:py-10">
                <div class="grid gap-6 lg:grid-cols-[120px_1fr]">
                    <div>
                        <span class="text-s font-bold uppercase tracking-[0.18em]">
                            01
                        </span>
                    </div>

                    <div>
                        <h2 class="font-serif text-4xl font-bold">
                            {copy.overview}
                        </h2>

                        <div class="mt-4 max-w-3xl space-y-3 text-base leading-7 text-black/75">
                            {copy.overviewText.map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                    </div>
                </div>
            </article>

            <!-- Research Areas -->
            <section class="border-b-2 border-black py-8 lg:py-10">
                <div class="grid gap-6 lg:grid-cols-[120px_1fr]">
                    <div>
                        <span class="text-s font-bold uppercase tracking-[0.18em]">
                            02
                        </span>
                    </div>

                    <div>
                        <h2 class="font-serif text-4xl font-bold">
                            {copy.areas}
                        </h2>

                        <div class="mt-7">
                            {sortedResearchAreas.map((area, index) => (
                                <article class="grid gap-6 border-b border-black/25 py-6 last:border-b-0 lg:grid-cols-[92px_1fr]">
                                    <div>
                                        <span class="font-serif text-xl font-bold leading-none text-black/20 md:text-4xl">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                    </div>

                                    <div class="grid gap-6 xl:grid-cols-[minmax(260px,0.9fr)_1fr]">
                                        <div>
                                            <h3 class="font-serif text-2xl font-bold leading-tight md:text-3xl">
                                                {area.title}
                                            </h3>
                                        </div>

                                        <div>
                                            <p class="text-base italic leading-7 text-black/70">
                                                {area.keywords.join(", ")}
                                            </p>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </div>
                    </div>
                </div>
            </section>

            <!-- Laboratories -->
            <section class="border-b-2 border-black py-8 lg:py-10">
                <div class="grid gap-6 lg:grid-cols-[120px_1fr]">
                    <div>
                        <span class="text-s font-bold uppercase tracking-[0.18em]">03</span>
                    </div>

                    <div>
                        <h2 class="font-serif text-4xl font-bold">{copy.laboratories}</h2>
                        <article class="mt-7 border border-black/15 bg-white p-5 md:p-6">
                            <h3 class="font-serif text-3xl font-bold leading-tight">
                                {laboratory.data.title}
                            </h3>
                            <div class="laboratory-content mt-5 max-w-4xl text-base leading-7 text-black/75">
                                <LaboratoryContent />
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <!-- Projects & Grants -->
            <section class="py-8 lg:py-10">
                <div class="grid gap-6 lg:grid-cols-[120px_1fr]">
                    <div>
                        <span class="text-s font-bold uppercase tracking-[0.18em]">
                            04
                        </span>
                    </div>

                    <div>
                        <h2 class="font-serif text-4xl font-bold">
                            {copy.projects}
                            <span class="align-middle font-sans text-lg font-semibold text-black/55">
                                ({sortedProjects.length})
                            </span>
                        </h2>

                        <p class="mt-4 text-base leading-7 text-black/75">
                            {copy.projectsSummary}
                        </p>
                        <div class="mt-7 grid gap-6">

                    {renderedProjects.map(({ entry: project, Content: ProjectContent }) => (
                        <article class="border border-black/15 bg-white p-5 md:p-6">
                            <h3 class="font-serif text-3xl font-bold">
                                {project.data.title}
                            </h3>
                            <div class="mt-5 flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-black/65">
                                {project.data.period && (
                                    <span class="border border-black/30 px-3 py-2">
                                        {project.data.period}
                                    </span>
                                )}
                                {project.data.code && (
                                    <span class="border border-black/30 px-3 py-2">
                                        {project.data.code}
                                    </span>
                                )}
                                <span class="border border-black/30 px-3 py-2">
                                    {project.data.role}
                                </span>
                                <span class="border border-black/30 px-3 py-2">
                                    {project.data.status}
                                </span>
                            </div>
                            <dl class="mt-5 grid gap-4 text-sm leading-6 text-black/70 md:grid-cols-2">
                                <div>
                                    <dt class="font-bold uppercase tracking-[0.14em] text-black">{copy.type}</dt>
                                    <dd class="mt-1">{project.data.type}</dd>
                                </div>
                                <div>
                                    <dt class="font-bold uppercase tracking-[0.14em] text-black">{copy.funding}</dt>
                                    <dd class="mt-1">{project.data.funding}</dd>
                                </div>
                            </dl>
                            <div class="project-content mt-4 w-full text-base leading-7 text-black/75">
                                <ProjectContent />
                            </div>

                            {project.data.links.length > 0 && (
                                <div class="mt-4 flex flex-wrap gap-4">
                                    {project.data.links.map((link) => (
                                        <a
                                            href={link.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="link"
                                        >
                                            {link.label}
                                        </a>
                                    ))}
                                </div>
                            )}

                            <div class="mt-6 flex flex-wrap gap-3">
                                {project.data.keywords.map((keyword) => (
                                <span class="italic text-sm  ">{keyword},</span>
                                ))}
                            </div>
                        </article>
                    ))}
                    </div>
                </div>
            </section>

        </section>
    </PageShell>
</MainLayout>
