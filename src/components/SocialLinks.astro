---
interface Link {
  label: string;
  href: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
import BrandLinks from "./BrandLinks.astro";
const textLinks = links.filter((link) => !["linkedin", "github"].includes(link.label.toLowerCase().replace(/\s+/g, "")));
const className = (label: string) =>
  `social-link social-link-${label.toLowerCase().replace(/\s+/g, "")}`;
---

<div class="flex flex-wrap gap-3">
  {textLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      class={className(link.label)}
    >
      {link.label}
    </a>
  ))}
  <BrandLinks />
</div>
