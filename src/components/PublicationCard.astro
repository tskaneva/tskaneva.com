---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { ui } from "../i18n";

interface Props {
  publication: CollectionEntry<"publicationsEn">["data"] | CollectionEntry<"publicationsBg">["data"];
  locale: Locale;
  index: number;
  headingLevel?: 2 | 4;
}

const { publication, locale, index, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}`;
const labels = ui[locale].publications.typeLabels;
const typeLabel = labels[publication.type as keyof typeof labels] ?? publication.type;
---

<article
  class="publication-item grid gap-3 border border-black/15 bg-white p-5 md:grid-cols-[72px_1fr] md:gap-5 md:p-6"
  data-title={publication.title.toLowerCase()}
  data-authors={publication.authors.toLowerCase()}
  data-venue={publication.venue.toLowerCase()}
  data-year={publication.year}
  data-type={publication.type}
  data-indexed={publication.indexed.join(",")}
>
  <div>
    <span class="text-xs font-bold uppercase tracking-[0.18em]">{publication.year}</span>
  </div>
  <div>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-black/60">
        {String(index + 1).padStart(2, "0")}
      </span>
      <span class="border border-black px-2 py-1 text-[10px] uppercase tracking-[0.18em] leading-none">
        {typeLabel}
      </span>
      {publication.indexed.map((indexing) => (
        <span class="border border-black/30 bg-black/5 px-2 py-1 text-[10px] uppercase tracking-[0.18em] leading-none text-black/70">
          {indexing}
        </span>
      ))}
      <span class="h-px flex-1 bg-black/20"></span>
    </div>

    <Heading class="font-serif text-xl font-bold leading-snug md:text-2xl">{publication.title}</Heading>
    <p class="mt-2 text-sm leading-6 text-black/75">{publication.authors}</p>
    <p class="mt-1 text-sm italic leading-6 text-black/65">{publication.venue}</p>

    {publication.links.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {publication.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">{link.label}</a>
        ))}
      </div>
    )}
  </div>
</article>
